# MISS CLOVER — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Flask ─────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# ── Server (used by gunicorn / cloudflared) ───────────────────────
GUNICORN_BIND=127.0.0.1:5002
GUNICORN_LOGLEVEL=info

# ── Database ──────────────────────────────────────────────────────
# Default sqlite db lives at instance/missclover.db
DATABASE_URL=sqlite:///missclover.db

# ── Public URLs ───────────────────────────────────────────────────
# Used to build absolute links in emails (guest-order tracker, password reset)
SITE_URL=http://127.0.0.1:5002

# ── Stripe (cards / PayNow / GrabPay via the Payment Element) ─────
# Build with TEST keys (sk_test_/pk_test_), then swap to live at go-live.
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret. Local testing: run
#   stripe listen --forward-to http://127.0.0.1:5002/checkout/stripe-webhook
# and copy the whsec_... it prints. Production: from the Dashboard webhook config.
STRIPE_WEBHOOK_SECRET=whsec_...
# Enable PayNow / GrabPay / cards under Dashboard → Settings → Payment methods.

# ── Mail (transactional email — order confirmation, password reset) ──
# Mailtrap.io credentials work fine for dev. Real SMTP in production.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=hello@missclover.co

# ── Shipping (flat rate for now; SGD cents) ───────────────────────
SHIPPING_FLAT_RATE_CENTS=800
FREE_SHIPPING_THRESHOLD_CENTS=20000

# ── Google sign-in (optional) ─────────────────────────────────────
# Drop the OAuth "web" client JSON at ./google_api_secret.json or in
# ./bizfile/ (client_secret_*.json) and it is picked up automatically.
# Override the location explicitly if you keep it elsewhere:
# GOOGLE_OAUTH_SECRET_FILE=/path/to/google_api_secret.json
